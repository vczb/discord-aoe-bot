{
  "name": "aoe-bot",
  "private": true,
  "version": "1.0.0",
  "description": "A Discord bot for Age of Empires II: Definitive Edition, providing various features and commands related to the game.",
  "main": "dist/app.js",
  "type": "module",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "start": "node dist/app.js",
    "register": "node dist/commands.js",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "migrate": "knex migrate:latest"
  },
  "author": "Shay DeWael",
  "license": "MIT",
  "dependencies": {
    "discord-interactions": "^4.0.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "knex": "^3.3.0",
    "node-cache": "^5.1.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-cache": "^4.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
